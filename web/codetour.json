        { "layer": "Logic", "file": "src/item.cpp", "symbol": "method:Item::remove", "note": "The only place where the quantity goes down." },
        { "layer": "Logic", "file": "src/inventory.cpp", "symbol": "method:Inventory::record", "note": "Appends to the journal with the balance after the movement." },
        { "layer": "Test", "file": "tests/inventory_test.cpp", "symbol": "test:InventoryTest.FailedIssueDoesNotWriteJournal", "note": "" },
